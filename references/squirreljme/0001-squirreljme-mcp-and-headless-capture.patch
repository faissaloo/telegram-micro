+	/**
+	 * Removes the given child from the parent.
+	 *
+	 * @param __parentP The parent pointer.
+	 * @param __childP The child pointer.
+	 * @since 2026/04/20
+	 */
+	private void __removeChild(long __parentP, long __childP)
+	{
+		Node parent = this._nodes.get(__parentP);
+		if (parent != null)
+			parent.children.remove(Long.valueOf(__childP));
+
+		Node child = this._nodes.get(__childP);
+		if (child != null)
+			child.parentPointer = null;
+	}
