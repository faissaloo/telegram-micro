+	/**
+	 * Returns whether the origin is accepted.
+	 *
+	 * @param __origin The origin header.
+	 * @return If the origin is accepted.
+	 * @since 2026/04/20
+	 */
+	private boolean __isAllowedOrigin(String __origin)
+	{
+		if (__origin == null || __origin.trim().isEmpty())
+			return true;
+
+		try
+		{
+			URI uri = URI.create(__origin.trim());
+			String host = uri.getHost();
+			if (host == null)
+				return false;
+
+			return "localhost".equalsIgnoreCase(host) ||
+				"127.0.0.1".equals(host) ||
+				"::1".equals(host) ||
+				"[::1]".equals(host);
+		}
+		catch (IllegalArgumentException __e)
+		{
+			return false;
+		}
+	}
