+sjme_errorCode sjme_scritchui_gtk2_componentScreenshot(
+	sjme_attrInNotNull sjme_scritchui inState,
+	sjme_attrInNotNull sjme_scritchui_uiComponent inComponent,
+	sjme_attrOutNotNull sjme_jint** outRgb,
+	sjme_attrOutNotNull sjme_jint* outWidth,
+	sjme_attrOutNotNull sjme_jint* outHeight)
+{
+	sjme_errorCode error;
+	GdkColormap* colormap;
+	GdkPixbuf* pixbuf;
+	GdkWindow* sourceWindow;
+	GtkAllocation alloc;
+	GtkWidget* sourceWidget;
+	GtkWidget* topLevel;
+	gboolean translated;
+	gint drawableW, drawableH;
+	gint height, nChannels, rowStride, srcX, srcY, width, xx, yy;
+	guchar* pixelBytes;
+	sjme_jint* argb;
+
+	if (inState == NULL || inComponent == NULL || outRgb == NULL ||
+		outWidth == NULL || outHeight == NULL)
+		return SJME_ERROR_NULL_ARGUMENTS;
+
+	*outRgb = NULL;
+	*outWidth = 0;
+	*outHeight = 0;
+
+	sourceWidget = (GtkWidget*)inComponent->common
+		.handle[SJME_SUI_GTK2_H_TOP_WIDGET];
+	if (sourceWidget == NULL)
+		sourceWidget = (GtkWidget*)inComponent->common
+			.handle[SJME_SUI_GTK2_H_WIDGET];
+	if (sourceWidget == NULL)
+		return SJME_ERROR_NATIVE_WIDGET_FAILURE;
+
+	topLevel = gtk_widget_get_toplevel(sourceWidget);
+	if (topLevel == NULL || !GTK_IS_WIDGET(topLevel))
+		topLevel = sourceWidget;
+
+	memset(&alloc, 0, sizeof(alloc));
+	gtk_widget_get_allocation(sourceWidget, &alloc);
+	width = alloc.width;
+	height = alloc.height;
+	if (width <= 0 || height <= 0)
+		return SJME_ERROR_INVALID_ARGUMENT;
+
+	if (inState->apiInThread->componentRevalidate != NULL)
+		if (sjme_error_is(error = inState->apiInThread->componentRevalidate(
+			inState, inComponent)))
+			return sjme_error_default(error);
+	if (inState->apiInThread->componentRepaint != NULL)
+		if (sjme_error_is(error = inState->apiInThread->componentRepaint(
+			inState, inComponent, 0, 0, width, height)))
+			return sjme_error_default(error);
+
+	while (gtk_events_pending())
+		gtk_main_iteration_do(FALSE);
+
+	sourceWindow = gtk_widget_get_window(topLevel);
+	if (sourceWindow == NULL)
+		sourceWindow = gtk_widget_get_window(sourceWidget);
+	if (sourceWindow == NULL)
+		return SJME_ERROR_NATIVE_WIDGET_FAILURE;
+
+	srcX = 0;
+	srcY = 0;
+	if (sourceWidget != topLevel)
+	{
+		translated = gtk_widget_translate_coordinates(sourceWidget, topLevel,
+			0, 0, &srcX, &srcY);
+		if (!translated)
+		{
+			srcX = alloc.x;
+			srcY = alloc.y;
+		}
+	}
+
+	drawableW = 0;
+	drawableH = 0;
+	gdk_drawable_get_size(GDK_DRAWABLE(sourceWindow), &drawableW, &drawableH);
+	if (srcX < 0)
+	{
+		width += srcX;
+		srcX = 0;
+	}
+	if (srcY < 0)
+	{
+		height += srcY;
+		srcY = 0;
+	}
+	if ((srcX + width) > drawableW)
+		width = drawableW - srcX;
+	if ((srcY + height) > drawableH)
+		height = drawableH - srcY;
+	if (width <= 0 || height <= 0)
+		return SJME_ERROR_INVALID_ARGUMENT;
+
+	gdk_window_process_updates(sourceWindow, TRUE);
+
+	colormap = gdk_drawable_get_colormap(GDK_DRAWABLE(sourceWindow));
+	if (colormap == NULL)
+		colormap = gdk_colormap_get_system();
+
+	pixbuf = gdk_pixbuf_get_from_drawable(NULL,
+		GDK_DRAWABLE(sourceWindow), colormap,
+		srcX, srcY, 0, 0, width, height);
+	if (pixbuf == NULL)
+		return SJME_ERROR_NATIVE_WIDGET_FAILURE;
+
+	argb = NULL;
+	if (sjme_error_is(error = sjme_alloc(inState->pool,
+		(width * height) * sizeof(*argb), (void**)&argb)) ||
+		argb == NULL)
+	{
+		g_object_unref(pixbuf);
+		return sjme_error_defaultOr(error, SJME_ERROR_OUT_OF_MEMORY);
+	}
+
+	pixelBytes = gdk_pixbuf_get_pixels(pixbuf);
+	rowStride = gdk_pixbuf_get_rowstride(pixbuf);
+	nChannels = gdk_pixbuf_get_n_channels(pixbuf);
+	for (yy = 0; yy < height; yy++)
+		for (xx = 0; xx < width; xx++)
+		{
+			guchar* at = pixelBytes + (yy * rowStride) + (xx * nChannels);
+			gint alpha = (nChannels >= 4 ? at[3] : 0xFF);
+			argb[(yy * width) + xx] = (alpha << 24) |
+				(at[0] << 16) | (at[1] << 8) | at[2];
+		}
+
+	g_object_unref(pixbuf);
+	*outRgb = argb;
+	*outWidth = width;
+	*outHeight = height;
+	return SJME_ERROR_NONE;
+}
