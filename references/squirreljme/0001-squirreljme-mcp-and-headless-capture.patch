@@ -417,14 +417,33 @@ sjme_errorCode sjme_scritchui_core_pseudoGraphics(
 	sjme_attrInPositiveNonZero sjme_jint numPencils,
 	sjme_attrInNullable const sjme_frontEndBindable* pencilFrontEndCopy)
 {
+	sjme_errorCode error;
+	sjme_alloc_weak resultWeak;
+
 	if (inState == NULL || outPencil == NULL || pencils == NULL)
 		return SJME_ERROR_NULL_ARGUMENTS;
 	
 	if (numPencils <= 0)
 		return SJME_ERROR_INVALID_ARGUMENT;
-	
-	sjme_todo("Impl?");
-	return sjme_error_notImplemented(0);
+
+	/* Fallback to the first pencil until proper multi-pencil composition is
+	implemented. This keeps framebuffer-backed UIs and launcher flows alive
+	on hosted targets where pseudo graphics are otherwise fatal. */
+	if (pencils[0] == NULL)
+		return SJME_ERROR_NULL_ARGUMENTS;
