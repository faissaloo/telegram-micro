+	/**
+	 * Returns the screenshot tool result.
+	 *
+	 * @param __arguments Tool arguments.
+	 * @return The result object.
+	 * @throws Exception On failures.
+	 * @since 2026/04/20
+	 */
+	private JsonObject __toolScreenshot(JsonObject __arguments)
+		throws Exception
+	{
+		final String controlId = DylibMcpServer.__string(__arguments, "id");
+		ScreenshotCapture capture = this.__onEventLoop(
+			new Work<ScreenshotCapture>()
+		{
+			@Override
+			public ScreenshotCapture run()
+				throws Exception
+			{
+				ScreenshotRequest request =
+					DylibMcpServer.this.__screenshotRequest(controlId);
+				return DylibMcpServer.this.__captureScreenshot(request);
+			}
+		});
+
+		if (capture == null || capture.bounds == null || capture.argb == null)
+			throw new ToolException("Could not capture control pixels.");
+
+		BufferedImage image = new BufferedImage(capture.bounds.width,
+			capture.bounds.height, BufferedImage.TYPE_INT_ARGB);
+		image.setRGB(0, 0, capture.bounds.width, capture.bounds.height,
+			capture.argb, 0, capture.bounds.width);
+		ByteArrayOutputStream png = new ByteArrayOutputStream();
+		ImageIO.write(image, "png", png);
+
+		JsonObjectBuilder payload = this._json.createObjectBuilder()
+			.add("resolvedId", capture.resolvedId)
+			.add("kind", capture.kind)
+			.add("bounds", this.__boundsObject(capture.bounds.x,
+				capture.bounds.y, capture.bounds.width, capture.bounds.height));
+		if (capture.controlId != null)
+			payload.add("id", capture.controlId);
+
+		return this.__toolSuccessWithImage(payload.build(),
+			Base64.getEncoder().encodeToString(png.toByteArray()), "image/png");
+	}
+
+	/**
+	 * Captures the rendered pixels for the given request.
+	 *
+	 * @param __request The screenshot request.
+	 * @return The captured pixels.
+	 * @throws ToolException If the request cannot be fulfilled.
+	 * @since 2026/04/20
+	 */
+	private ScreenshotCapture __captureScreenshot(ScreenshotRequest __request)
+		throws ToolException
+	{
+		if (__request == null || __request.component == null)
+			throw new ToolException("No component is available for capture.");
+
+		int[] size = new int[2];
+		int[] argb;
+		try
+		{
+			argb = this._api.component.componentScreenshot(__request.component,
+				size);
+		}
+		catch (MLECallError __e)
+		{
+			throw new ToolException("Component capture failed.", __e);
+		}
+
+		if (argb == null || size[0] <= 0 || size[1] <= 0)
+			throw new ToolException("Component capture returned no pixels.");
+		if (argb.length < (size[0] * size[1]))
+			throw new ToolException("Component capture returned truncated pixels.");
+
+		Rectangle bounds = __request.bounds;
+		if (bounds == null)
+			bounds = new Rectangle(0, 0, size[0], size[1]);
+		else
+			bounds = new Rectangle(bounds.x, bounds.y, size[0], size[1]);
+
+		return new ScreenshotCapture(__request.controlId, __request.kind,
+			__request.resolvedId, bounds, argb);
+	}
+
+	/**
+	 * Builds a snapshot of the current UI state.
+	 *
+	 * @param __rootId The optional root ID.
+	 * @return The snapshot payload.
+	 * @throws ToolException If the root ID is invalid.
+	 * @since 2026/04/20
+	 */
+	private JsonObject __snapshot(String __rootId)
+		throws ToolException
+	{
+		Long rootPointer = null;
+		if (__rootId != null && !__rootId.trim().isEmpty())
+			rootPointer = Long.valueOf(this.__requireNodeById(__rootId).pointer);
+
+		JsonArrayBuilder controls = this._json.createArrayBuilder();
+		JsonArrayBuilder roots = this._json.createArrayBuilder();
+
+		synchronized (this)
+		{
+			for (Node node : this._nodes.values())
+				if (node.parentPointer == null)
+					roots.add(node.id);
+
+			for (Node node : this._nodes.values())
+				if (rootPointer == null || this.__isUnderRoot(node, rootPointer))
+					controls.add(this.__snapshotNode(node));
+		}
+
+		JsonObjectBuilder result = this._json.createObjectBuilder()
+			.add("controls", controls.build())
+			.add("roots", roots.build());
+
+		if (rootPointer != null)
+			result.add("rootId", this.__node(rootPointer.longValue()).id);
+
+		return result.build();
+	}
+
+	/**
+	 * Returns whether the given node is under the given root.
+	 *
+	 * @param __node The node to inspect.
+	 * @param __rootPointer The root pointer.
+	 * @return If the node is under the root.
+	 * @since 2026/04/20
+	 */
+	private boolean __isUnderRoot(Node __node, Long __rootPointer)
+	{
+		if (__node == null || __rootPointer == null)
+			return false;
+
+		Node at = __node;
+		while (at != null)
+		{
+			if (at.pointer == __rootPointer.longValue())
+				return true;
+			if (at.parentPointer == null)
+				break;
+			at = this._nodes.get(at.parentPointer);
+		}
+		return false;
+	}
+
+	/**
+	 * Builds a snapshot node payload.
+	 *
+	 * @param __node The node to build.
+	 * @return The node payload.
+	 * @since 2026/04/20
+	 */
+	private JsonObject __snapshotNode(Node __node)
+	{
+		JsonObjectBuilder out = this._json.createObjectBuilder()
+			.add("id", __node.id)
+			.add("pointer", String.format("0x%x", __node.pointer))
+			.add("kind", __node.kind);
+
+		if (__node.parentPointer != null)
+			out.add("parentId", this.__node(__node.parentPointer).id);
+
+		JsonArrayBuilder children = this._json.createArrayBuilder();
+		for (Long childP : __node.children)
+			children.add(this.__node(childP.longValue()).id);
+		out.add("children", children.build());
+
+		if (__node.label != null)
+			out.add("label", __node.label);
+		if (__node.relativeBounds != null)
+			out.add("relativeBounds",
+				this.__boundsObject(__node.relativeBounds[0],
+					__node.relativeBounds[1], __node.relativeBounds[2],
+					__node.relativeBounds[3]));
+		if (__node.viewArea != null)
+			out.add("viewArea", this.__sizeObject(
+				__node.viewArea[0], __node.viewArea[1]));
+		if (__node.minimumContentSize != null)
+			out.add("minimumContentSize", this.__sizeObject(
+				__node.minimumContentSize[0], __node.minimumContentSize[1]));
+		if (__node.focusEnabled != null)
+			out.add("focusEnabled", __node.focusEnabled.booleanValue());
+		if (__node.defaultFocus != null)
+			out.add("defaultFocus", __node.defaultFocus.booleanValue());
+		if (__node.visible != null)
+			out.add("visible", __node.visible.booleanValue());
+		if (__node.lastEvent != null)
+		{
+			JsonObjectBuilder lastEvent = this._json.createObjectBuilder()
+				.add("name", __node.lastEvent);
+			if (__node.lastEventDetail != null)
+				lastEvent.add("detail", __node.lastEventDetail);
+			if (__node.lastEventMillis != null)
+				lastEvent.add("time", __node.lastEventMillis.longValue());
+			out.add("lastEvent", lastEvent.build());
+		}
+
+		if (__node.object instanceof DylibScreenObject)
+		{
+			int[] pixels = new int[4];
+			int[] mm = new int[4];
+			this._api.screen().screenGetBounds((DylibScreenObject)__node.object,
+				null, pixels, mm);
+			out.add("screenId", this._api.screen().screenId(
+				(DylibScreenObject)__node.object));
+			out.add("bounds", this.__boundsObject(pixels[0], pixels[1],
+				pixels[2], pixels[3]));
+		}
+
+		if (__node.object instanceof DylibContainerObject)
+		{
+			int[] contentSize = new int[2];
+			int[] frameBound = new int[4];
+			int[] contentBound = new int[4];
+			this._api.container().containerGetFrame(
+				(ScritchContainerBracket)__node.object,
+				contentSize, frameBound, contentBound);
+			out.add("frameBounds", this.__boundsObject(frameBound[0],
+				frameBound[1], frameBound[2], frameBound[3]));
+			out.add("contentBounds", this.__boundsObject(contentBound[0],
+				contentBound[1], contentBound[2], contentBound[3]));
+			out.add("contentSize", this.__sizeObject(
+				contentSize[0], contentSize[1]));
+		}
+
+		if (__node.object instanceof DylibComponentObject)
+		{
+			out.add("size", this.__sizeObject(
+				this._api.component().componentWidth(
+					(DylibComponentObject)__node.object),
+				this._api.component().componentGetHeight(
+					(DylibComponentObject)__node.object)));
+		}
+
+		if (__node.object instanceof DylibWindowObject)
+			out.add("visible", this._api.window().windowIsVisible(
+				(DylibWindowObject)__node.object));
+
+		if (__node.object instanceof DylibChoiceObject)
+		{
+			int selectedIndex = this._api.choice().choiceGetSelectedIndex(
+				(ScritchChoiceBracket)__node.object);
+			out.add("selectedIndex", selectedIndex);
+
+			JsonArrayBuilder entries = this._json.createArrayBuilder();
+			for (int i = 0; i < __node.choiceEntries.size(); i++)
+			{
+				ChoiceEntry entry = __node.choiceEntries.get(i);
+				JsonObjectBuilder item = this._json.createObjectBuilder()
+					.add("index", i);
+				if (entry.label != null)
+					item.add("label", entry.label);
+				if (entry.enabled != null)
+					item.add("enabled", entry.enabled.booleanValue());
+				if (entry.selected != null)
+					item.add("selected", entry.selected.booleanValue());
+				entries.add(item.build());
+			}
+			out.add("choices", entries.build());
+		}
+
+		JsonArrayBuilder actions = this._json.createArrayBuilder();
+		for (String action : this.__actions(__node))
+			actions.add(action);
+		out.add("actions", actions.build());
+
+		return out.build();
+	}
+
+	/**
+	 * Returns available actions for the given node.
+	 *
+	 * @param __node The node to inspect.
+	 * @return The available actions.
+	 * @since 2026/04/20
+	 */
+	private List<String> __actions(Node __node)
+	{
+		LinkedHashSet<String> result = new LinkedHashSet<>();
+
+		if (__node.activateListener != null)
+			result.add("activate");
+
+		if (__node.object instanceof DylibMenuKindObject &&
+			this.__windowForMenuNode(__node) != null)
+			result.add("activate");
+
+		if (__node.inputListener != null)
+			result.add("send_input");
+
+		if (__node.object instanceof DylibChoiceObject)
+			result.add("select_choice");
+
+		if (__node.object instanceof DylibWindowObject)
+		{
+			result.add("set_window_visible");
+			if (__node.closeListener != null)
+				result.add("close_window");
+		}
+
+		if (__node.object instanceof DylibComponentObject &&
+			__node.parentPointer != null)
+			result.add("set_bounds");
+
+		if (this.__resolvedScreenshotTarget(__node) != null)
+			result.add("screenshot");
+
+		return new ArrayList<>(result);
