+	/**
+	 * HTTP handler for the MCP endpoint.
+	 *
+	 * @since 2026/04/20
+	 */
+	private final class DylibMcpHttpHandler
+		implements HttpHandler
+	{
+		/**
+		 * {@inheritDoc}
+		 * @since 2026/04/20
+		 */
+		@Override
+		public void handle(HttpExchange __exchange)
+			throws IOException
+		{
+			try
+			{
+				String origin = __exchange.getRequestHeaders().getFirst("Origin");
+				if (!DylibMcpServer.this.__isAllowedOrigin(origin))
+				{
+					DylibMcpServer.this.__sendJson(__exchange, 403,
+						DylibMcpServer.this.__jsonRpcError(null, -32000,
+							"Forbidden Origin."));
+					return;
+				}
+
+				String method = __exchange.getRequestMethod();
+				if ("GET".equalsIgnoreCase(method))
+				{
+					__exchange.getResponseHeaders().set("Allow", "POST");
+					DylibMcpServer.this.__sendEmpty(__exchange, 405);
+					return;
+				}
+
+				if (!"POST".equalsIgnoreCase(method))
+				{
+					__exchange.getResponseHeaders().set("Allow", "GET, POST");
+					DylibMcpServer.this.__sendEmpty(__exchange, 405);
+					return;
+				}
+
+				JsonObject request;
+				try (InputStream in = __exchange.getRequestBody())
+				{
+					request = DylibMcpServer.this._json.createReader(in).readObject();
+				}
+
+				JsonValue id = request.get("id");
+				String rpcMethod = DylibMcpServer.__string(request, "method");
+
+				if (rpcMethod == null)
+				{
+					DylibMcpServer.this.__sendEmpty(__exchange, 202);
+					return;
+				}
+
+				if ("initialize".equals(rpcMethod))
+				{
+					JsonObjectBuilder serverInfo =
+						DylibMcpServer.this._json.createObjectBuilder()
+							.add("name", "SquirrelJME ScritchUI MCP")
+							.add("version", "0.3.0");
+
+					JsonObjectBuilder capabilities =
+						DylibMcpServer.this._json.createObjectBuilder()
+							.add("tools",
+								DylibMcpServer.this._json.createObjectBuilder()
+									.add("listChanged", false)
+									.build());
+
+					JsonObject result = DylibMcpServer.this._json.createObjectBuilder()
+						.add("protocolVersion", DylibMcpServer.PROTOCOL_VERSION)
+						.add("capabilities", capabilities.build())
+						.add("serverInfo", serverInfo.build())
+						.add("instructions",
+							"Use the scritch.* tools to inspect controls, " +
+							"drive activation and input listeners, change " +
+							"window/component state, and capture screenshots.")
+						.build();
+
+					DylibMcpServer.this.__sendJson(__exchange, 200,
+						DylibMcpServer.this.__jsonRpcResult(id, result));
+					return;
+				}
+
+				if (rpcMethod.startsWith("notifications/"))
+				{
+					DylibMcpServer.this.__sendEmpty(__exchange, 202);
+					return;
+				}
+
+				if ("ping".equals(rpcMethod))
+				{
+					DylibMcpServer.this.__sendJson(__exchange, 200,
+						DylibMcpServer.this.__jsonRpcResult(id,
+							DylibMcpServer.this._json.createObjectBuilder()
+								.build()));
+					return;
+				}
+
+				if ("tools/list".equals(rpcMethod))
+				{
+					DylibMcpServer.this.__sendJson(__exchange, 200,
+						DylibMcpServer.this.__jsonRpcResult(id,
+							DylibMcpServer.this.__toolListPayload()));
+					return;
+				}
+
+				if ("tools/call".equals(rpcMethod))
+				{
+					JsonObject params = DylibMcpServer.__object(request, "params");
+					String name = DylibMcpServer.__string(params, "name");
+					JsonObject arguments = DylibMcpServer.__object(params,
+						"arguments");
+
+					JsonObject result;
+					try
+					{
+						result = DylibMcpServer.this.__callTool(name, arguments);
+					}
+					catch (ToolException __e)
+					{
+						result = DylibMcpServer.this.__toolError(__e.getMessage());
+					}
+					catch (Exception __e)
+					{
+						result = DylibMcpServer.this.__toolError(
+							(__e.getMessage() == null ? __e.toString() :
+								__e.getMessage()));
+					}
+
+					DylibMcpServer.this.__sendJson(__exchange, 200,
+						DylibMcpServer.this.__jsonRpcResult(id, result));
+					return;
+				}
+
+				DylibMcpServer.this.__sendJson(__exchange, 200,
+					DylibMcpServer.this.__jsonRpcError(id, -32601,
+						"Method not found."));
+			}
+			finally
+			{
+				__exchange.close();
+			}
+		}
+	}
