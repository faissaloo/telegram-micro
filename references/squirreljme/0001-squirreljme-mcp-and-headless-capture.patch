+	 *
+	 * @param __objectP The object pointer to forget.
+	 * @since 2026/04/20
+	 */
+	void forget(long __objectP)
+	{
+		synchronized (this)
+		{
+			Node remove = this._nodes.remove(__objectP);
+			if (remove == null)
+				return;
