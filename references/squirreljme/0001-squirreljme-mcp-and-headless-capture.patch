+		int __type, long __time, int __a, int __b, int __c, int __d, int __e,
+		int __f, int __g, int __h, int __i, int __j, int __k, int __l)
+	{
+		Form form = this._form.get();
+		if (form == null)
+			return;
+
+		switch (__type)
+		{
+			case ScritchInputMethodType.KEY_CHAR_PRESSED:
+				form.__handleCharacter((char)__a);
+				break;
+
+			case ScritchInputMethodType.KEY_PRESSED:
+				if (__a == '\t')
+					form.__advanceFocus(1);
+				else if (__a == '\b' || __a == 127)
+					form.__handleCharacter('\b');
+				break;
+		}
+	}
