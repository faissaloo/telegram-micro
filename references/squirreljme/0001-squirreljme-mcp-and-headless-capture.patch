+	/**
+	 * Sets the parent-child relationship.
+	 *
+	 * @param __childP The child pointer.
+	 * @param __parentP The parent pointer.
+	 * @param __at The insertion index, negative to append.
+	 * @since 2026/04/20
+	 */
+	private void __setParent(long __childP, long __parentP, int __at)
+	{
+		Node child = this.__node(__childP);
+		Node parent = this.__node(__parentP);
+
+		if (child.parentPointer != null)
+		{
+			Node oldParent = this._nodes.get(child.parentPointer);
+			if (oldParent != null)
+				oldParent.children.remove(Long.valueOf(__childP));
+		}
+
+		child.parentPointer = Long.valueOf(__parentP);
+		parent.children.remove(Long.valueOf(__childP));
+
+		if (__at < 0 || __at >= parent.children.size())
+			parent.children.add(Long.valueOf(__childP));
+		else
+			parent.children.add(__at, Long.valueOf(__childP));
+	}
