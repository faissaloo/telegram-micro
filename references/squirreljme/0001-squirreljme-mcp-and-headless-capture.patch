+	/**
+	 * Returns the screenshot request for the given control.
+	 *
+	 * @param __controlId The control ID.
+	 * @return The screenshot request.
+	 * @throws ToolException If the control does not exist.
+	 * @since 2026/04/20
+	 */
+	private ScreenshotRequest __screenshotRequest(String __controlId)
+		throws ToolException
+	{
+		Node target = null;
+		if (__controlId != null && !__controlId.trim().isEmpty())
+			target = this.__requireNodeById(__controlId);
+
+		if (target == null)
+			target = this.__defaultScreenshotTarget();
+		else if (target.object instanceof DylibScreenObject)
+			target = this.__descendantScreenshotTarget(target);
+
+		if (target == null)
+			throw new ToolException("There is no visible application window to capture.");
+
+		Node resolved = this.__resolvedScreenshotTarget(target);
+		if (resolved == null)
+			throw new ToolException(String.format(
+				"Control %s cannot be captured.", target.id));
+
+		Rectangle bounds = this.__captureBounds(resolved);
+		if (bounds == null)
+			throw new ToolException(String.format(
+				"Control %s does not expose capture bounds.", resolved.id));
+
+		return new ScreenshotRequest(__controlId,
+			(DylibComponentObject)resolved.object, resolved.kind,
+			resolved.id, bounds);
+	}
+
+	/**
+	 * Returns the resolved screenshot target.
+	 *
+	 * @param __node The source node.
+	 * @return The resolved screenshot node, if any.
+	 * @since 2026/04/20
+	 */
+	private Node __resolvedScreenshotTarget(Node __node)
+	{
+		Node at = __node;
+		while (at != null)
+		{
+			if (at.object instanceof DylibComponentObject)
+				return at;
+			if (at.parentPointer == null)
+				break;
+			at = this._nodes.get(at.parentPointer);
+		}
+		return null;
+	}
+
+	/**
+	 * Returns the default screenshot target.
+	 *
+	 * @return The default target, if any.
+	 * @since 2026/04/20
+	 */
+	private Node __defaultScreenshotTarget()
+	{
+		Node fallback = null;
+
+		synchronized (this)
+		{
+			for (Node node : this._nodes.values())
+				if (node.object instanceof DylibWindowObject &&
+					this.__nodeVisible(node))
+					return node;
+
+			for (Node node : this._nodes.values())
+				if (fallback == null &&
+					node.object instanceof DylibComponentObject)
+					fallback = node;
+		}
+
+		return fallback;
+	}
+
+	/**
+	 * Returns the first descendant screenshot target under the given node.
+	 *
+	 * @param __root The root node.
+	 * @return The descendant target, if any.
+	 * @since 2026/04/20
+	 */
+	private Node __descendantScreenshotTarget(Node __root)
+	{
+		if (__root == null)
+			return null;
+
+		Node fallback = null;
+		for (Long childP : __root.children)
+		{
+			Node child = this._nodes.get(childP);
+			if (child == null)
+				continue;
+
+			if (child.object instanceof DylibWindowObject &&
+				this.__nodeVisible(child))
+				return child;
+
+			if (fallback == null && child.object instanceof DylibComponentObject)
+				fallback = child;
+
+			Node nested = this.__descendantScreenshotTarget(child);
+			if (nested != null)
+				return nested;
+		}
+		return fallback;
+	}
+
+	/**
+	 * Returns whether the node is visible.
+	 *
+	 * @param __node The node to inspect.
+	 * @return If the node is visible.
+	 * @since 2026/04/20
+	 */
+	private boolean __nodeVisible(Node __node)
+	{
+		if (__node == null)
+			return false;
+		if (__node.object instanceof DylibWindowObject)
+			return this._api.window().windowIsVisible(
+				(DylibWindowObject)__node.object);
+		return (__node.visible == null || __node.visible.booleanValue());
+	}
+
+	/**
+	 * Returns the capture bounds for the given node.
+	 *
+	 * @param __node The node to inspect.
+	 * @return The capture bounds, if available.
+	 * @since 2026/04/20
+	 */
+	private Rectangle __captureBounds(Node __node)
+	{
+		if (__node.object instanceof DylibComponentObject)
+			return this.__componentBounds(__node);
+
+		return null;
+	}
+
+	/**
+	 * Returns the component bounds.
+	 *
+	 * @param __node The node to inspect.
+	 * @return The component bounds.
+	 * @since 2026/04/20
+	 */
+	private Rectangle __componentBounds(Node __node)
+	{
+		if (__node == null || !(__node.object instanceof DylibComponentObject))
+			return null;
+
+		int width = this._api.component().componentWidth(
+			(DylibComponentObject)__node.object);
+		int height = this._api.component().componentGetHeight(
+			(DylibComponentObject)__node.object);
+
+		if (__node.parentPointer == null)
+			return new Rectangle(0, 0, width, height);
+
+		Node parent = this._nodes.get(__node.parentPointer.longValue());
+		if (parent != null && parent.object instanceof DylibScreenObject)
+			return new Rectangle(0, 0, width, height);
+
+		Point origin = this.__contentOrigin(__node.parentPointer.longValue());
+		if (origin == null)
+			return null;
+
+		int x = origin.x;
+		int y = origin.y;
+		if (__node.relativeBounds != null)
+		{
+			x += __node.relativeBounds[0];
+			y += __node.relativeBounds[1];
+			width = __node.relativeBounds[2];
+			height = __node.relativeBounds[3];
+		}
+
+		return new Rectangle(x, y, width, height);
+	}
+
+	/**
+	 * Returns the content origin for the given container.
+	 *
+	 * @param __containerP The container pointer.
+	 * @return The content origin.
+	 * @since 2026/04/20
+	 */
+	private Point __contentOrigin(long __containerP)
+	{
+		Node parent = this._nodes.get(__containerP);
+		if (parent == null || !(parent.object instanceof DylibContainerObject))
+			return null;
+
+		int[] content = new int[4];
+		this._api.container().containerGetFrame(
+			(ScritchContainerBracket)parent.object, null, null, content);
+		return new Point(content[0], content[1]);
+	}
