+JNIEXPORT jintArray JNICALL FORWARD_FUNC_NAME(NativeScritchDylib,
+	__componentScreenshot)(JNIEnv* env, jclass classy, jlong stateP,
+	jlong componentP, jintArray sizeOut)
+{
+	sjme_errorCode error;
+	sjme_scritchui state;
+	sjme_scritchui_uiComponent component;
+	sjme_jint* argb;
+	sjme_jint width;
+	sjme_jint height;
+	jintArray result;
+
+	if (stateP == 0 || componentP == 0 || sizeOut == NULL)
+	{
+		sjme_jni_throwMLECallError(env, SJME_ERROR_NULL_ARGUMENTS);
+		return NULL;
+	}
+
+	state = (sjme_scritchui)stateP;
+	component = (sjme_scritchui_uiComponent)componentP;
+
+	argb = NULL;
+	width = 0;
+	height = 0;
+	result = NULL;
+	error = SJME_ERROR_NATIVE_WIDGET_FAILURE;
+	if (state->apiInThread->componentScreenshot == NULL ||
+		sjme_error_is(error = state->apiInThread->componentScreenshot(
+			state, component, &argb, &width, &height)))
+	{
+		sjme_jni_throwMLECallError(env, error);
+		return NULL;
+	}
+
+	result = (*env)->NewIntArray(env, width * height);
+	if (result == NULL)
+	{
+		if (argb != NULL)
+			sjme_alloc_free(argb);
+		return NULL;
+	}
+
+	(*env)->SetIntArrayRegion(env, result, 0, width * height, argb);
+	if (argb != NULL)
+		sjme_alloc_free(argb);
+
+	if (sjme_jni_checkVMException(env))
+		return NULL;
+
+	if (sjme_error_is(sjme_jni_setIntArray(env, sizeOut, 0, 2,
+		width, height)))
+	{
+		sjme_jni_throwMLECallError(env, SJME_ERROR_INDEX_OUT_OF_BOUNDS);
+		return NULL;
+	}
+
+	return result;
+}
+
