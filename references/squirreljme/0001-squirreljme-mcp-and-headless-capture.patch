+	/**
+	 * Detaches the given node from its parent.
+	 *
+	 * @param __node The node to detach.
+	 * @since 2026/04/20
+	 */
+	private void __detachFromParent(Node __node)
+	{
+		if (__node == null || __node.parentPointer == null)
+			return;
+
+		Node parent = this._nodes.get(__node.parentPointer);
+		if (parent != null)
+			parent.children.remove(Long.valueOf(__node.pointer));
+		__node.parentPointer = null;
+	}
