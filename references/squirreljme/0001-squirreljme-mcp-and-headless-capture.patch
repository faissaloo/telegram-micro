+	/**
+	 * Executes work on the ScritchUI event loop.
+	 *
+	 * @param __work The work to execute.
+	 * @return The resultant value.
+	 * @throws Exception On failures.
+	 * @since 2026/04/20
+	 */
+	private <T> T __onEventLoop(Work<T> __work)
+		throws Exception
+	{
+		if (__work == null)
+			throw new NullPointerException("NARG");
+
+		final Holder<T> result = new Holder<>();
+		final Exception[] failure = new Exception[1];
+
+		this._api.eventLoop().loopExecuteWait(new Runnable()
+		{
+			@Override
+			public void run()
+			{
+				try
+				{
+					result.value = __work.run();
+				}
+				catch (Exception __e)
+				{
+					failure[0] = __e;
+				}
+			}
+		});
+
+		if (failure[0] != null)
+			throw failure[0];
+		return result.value;
+	}
