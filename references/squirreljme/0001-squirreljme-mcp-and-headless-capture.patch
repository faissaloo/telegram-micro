+			{
+				String line = __text.substring(lineStart, i);
+				String visibleLine = this.__fitHead(__font, line, __width);
+				__gfx.drawString(visibleLine, __x, __y,
+					Graphics.TOP | Graphics.LEFT);
+				__y += lineHeight;
+				lineStart = i + 1;
+			}
+
+		return __y;
+	}
+
+	/**
+	 * Fits the tail of the given string within the available width.
+	 *
+	 * @param __font The font being used.
+	 * @param __text The text to fit.
+	 * @param __width The maximum width.
+	 * @return The displayable text.
+	 * @since 2026/04/21
+	 */
+	private String __fitTail(Font __font, String __text, int __width)
+	{
+		if (__text == null || __text.length() == 0 || __width <= 0)
+			return "";
+
+		if (__font.stringWidth(__text) <= __width)
+			return __text;
+
+		int start = __text.length();
+		while (start > 0 &&
+			__font.stringWidth(__text.substring(start - 1)) <= __width)
+			start--;
+
+		return __text.substring(start);
+	}
+
+	/**
+	 * Fits the head of the given string within the available width.
+	 *
+	 * @param __font The font being used.
+	 * @param __text The text to fit.
+	 * @param __width The maximum width.
+	 * @return The displayable text.
+	 * @since 2026/04/21
+	 */
+	private String __fitHead(Font __font, String __text, int __width)
+	{
+		if (__text == null || __text.length() == 0 || __width <= 0)
+			return "";
+
+		if (__font.stringWidth(__text) <= __width)
+			return __text;
+
+		int end = __text.length();
+		while (end > 0 && __font.stringWidth(__text.substring(0, end)) > __width)
+			end--;
+
+		return __text.substring(0, end);
+	}
+}
