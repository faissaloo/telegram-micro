+	/**
+	 * Normalizes the endpoint path.
+	 *
+	 * @param __path The path to normalize.
+	 * @return The normalized path.
+	 * @throws NullPointerException On null arguments.
+	 * @since 2026/04/20
+	 */
+	private static String __normalizeEndpointPath(String __path)
+		throws NullPointerException
+	{
+		if (__path == null)
+			throw new NullPointerException("NARG");
+
+		String path = __path.trim();
+		if (path.isEmpty())
+			return "/mcp";
+		if (!path.startsWith("/"))
+			path = "/" + path;
+		return path;
+	}
+
+	/**
+	 * Determines the kind of the given object.
+	 *
+	 * @param __object The object to inspect.
+	 * @return The detected kind.
+	 * @since 2026/04/20
+	 */
+	private String __kind(DylibBaseObject __object)
+	{
+		if (__object instanceof DylibScreenObject)
+			return "screen";
+		if (__object instanceof DylibWindowObject)
+			return "window";
+		if (__object instanceof DylibScrollPanelObject)
+			return "scroll-panel";
+		if (__object instanceof DylibPanelObject)
+			return "panel";
+		if (__object instanceof DylibListObject)
+			return "list";
+		if (__object instanceof DylibMenuBarObject)
+			return "menu-bar";
+		if (__object instanceof DylibMenuItemObject)
+			return "menu-item";
+		if (__object instanceof DylibMenuObject)
+			return "menu";
+
+		if (__object instanceof DylibChoiceObject)
+			return "choice";
+		if (__object instanceof DylibContainerObject)
+			return "container";
+		if (__object instanceof DylibComponentObject)
+			return "component";
+		return "object";
+	}
+
+	/**
+	 * Returns the node for the given pointer.
+	 *
+	 * @param __pointer The pointer to look up.
+	 * @return The resultant node.
+	 * @since 2026/04/20
+	 */
+	private Node __node(long __pointer)
+	{
+		Node rv = this._nodes.get(__pointer);
+		if (rv == null)
+		{
+			rv = new Node(__pointer);
+			this._nodes.put(__pointer, rv);
+		}
+		return rv;
+	}
