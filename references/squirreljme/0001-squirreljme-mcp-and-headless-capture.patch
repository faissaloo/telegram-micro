+	/**
+	 * Returns the window for a given menu node.
+	 *
+	 * @param __node The node to inspect.
+	 * @return The owning window or {@code null}.
+	 * @since 2026/04/20
+	 */
+	private Node __windowForMenuNode(Node __node)
+	{
+		Node at = __node;
+		while (at != null)
+		{
+			if (at.object instanceof DylibWindowObject &&
+				at.menuItemActivateListener != null)
+				return at;
+			if (at.parentPointer == null)
+				break;
+			at = this._nodes.get(at.parentPointer);
+		}
+		return null;
+	}
