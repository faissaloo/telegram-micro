+	/**
+	 * Starts the HTTP server, if configured.
+	 *
+	 * @since 2026/04/20
+	 */
+	private void __startIfRequested()
+	{
+		synchronized (this)
+		{
+			if (this._server != null)
+				return;
+
+			String rawPort = System.getProperty(DylibMcpServer.PORT_PROPERTY);
+			if (rawPort == null || rawPort.trim().isEmpty())
+				return;
+
+			final int port;
+			try
+			{
+				port = Integer.parseInt(rawPort.trim());
+			}
+			catch (NumberFormatException __e)
+			{
+				throw new IllegalArgumentException(String.format(
+					"Invalid MCP port: %s", rawPort), __e);
+			}
+
+			if (port <= 0)
+				return;
+
+			try
+			{
+				HttpServer server = HttpServer.create(
+					new InetSocketAddress(InetAddress.getByName("127.0.0.1"),
+						port), 0);
+				server.createContext(this._endpointPath, new DylibMcpHttpHandler());
+				server.setExecutor(Executors.newCachedThreadPool());
+				server.start();
+				this._server = server;
+
+				System.err.println(String.format(
+					"SquirrelJME MCP listening on http://127.0.0.1:%d%s",
+					port, this._endpointPath));
+			}
+			catch (IOException __e)
+			{
+				throw new RuntimeException("Could not start MCP server.", __e);
+			}
+		}
+	}
