+package cc.squirreljme.emulator.gcf;
+
+import cc.squirreljme.runtime.gcf.IPAddress;
+import cc.squirreljme.runtime.gcf.IPConnectionFactory;
+import cc.squirreljme.runtime.gcf.TCPClientConnection;
+import java.io.IOException;
+import java.net.InetAddress;
+import java.net.InetSocketAddress;
+import java.net.Socket;
+import java.net.UnknownHostException;
+import javax.microedition.io.ConnectionNotFoundException;
+import javax.microedition.io.Connector;
+
+/**
+ * Uses the host Java runtime for IP connections made by hosted SquirrelJME.
+ *
+ * @since 2026/07/21
+ */
+public final class HostIPConnectionFactory
+	extends IPConnectionFactory
+{
+	/**
+	 * {@inheritDoc}
+	 * @since 2026/07/21
+	 */
+	@Override
+	public IPAddress resolveAddress(IPAddress __addr)
+		throws ConnectionNotFoundException, IOException, NullPointerException
+	{
+		if (__addr == null)
+			throw new NullPointerException("NARG");
+
+		String host = HostIPConnectionFactory.__unbracket(__addr.hostname);
+		if (host == null || host.length() == 0)
+			throw new ConnectionNotFoundException("EC0i");
+
+		try
+		{
+			String numeric = InetAddress.getByName(host).getHostAddress();
+
+			// IPAddress cannot represent Java's scoped IPv6 form yet.
+			if (numeric.indexOf('%') >= 0)
+				throw new ConnectionNotFoundException("EC0i");
+			if (numeric.indexOf(':') >= 0)
+				numeric = '[' + numeric + ']';
+
+			return new IPAddress(numeric, __addr.port);
+		}
+		catch (UnknownHostException e)
+		{
+			throw new ConnectionNotFoundException("EC0i");
+		}
+	}
+
+	/**
+	 * {@inheritDoc}
+	 * @since 2026/07/21
+	 */
+	@Override
+	public TCPClientConnection tcpClientConnect(IPAddress __addr, int __mode)
+		throws ConnectionNotFoundException, IOException, NullPointerException
+	{
+		if (__addr == null)
+			throw new NullPointerException("NARG");
+		if (__addr.hostname == null ||
+			__addr.port == IPAddress.ASSIGNED_PORT)
+			throw new ConnectionNotFoundException("EC0j");
+		if (__mode != Connector.READ && __mode != Connector.WRITE &&
+			__mode != Connector.READ_WRITE)
+			throw new IllegalArgumentException("EC20 " + __mode);
+
+		Socket socket = new Socket();
+		try
+		{
+			socket.connect(new InetSocketAddress(
+				HostIPConnectionFactory.__unbracket(__addr.hostname),
+				__addr.port));
+			return new HostTCPClientConnection(__addr, __mode, socket);
+		}
+		catch (IOException e)
+		{
+			try
+			{
+				socket.close();
+			}
+			catch (IOException ignored)
+			{
+			}
+			throw e;
+		}
+	}
+
+	/**
+	 * Removes URI brackets from an IPv6 host.
+	 *
+	 * @param __host The host.
+	 * @return The unbracketed host.
+	 * @since 2026/07/21
+	 */
+	private static String __unbracket(String __host)
+	{
+		if (__host != null && __host.length() >= 2 &&
+			__host.charAt(0) == '[' &&
+			__host.charAt(__host.length() - 1) == ']')
+			return __host.substring(1, __host.length() - 1);
+		return __host;
+	}
+}
diff --git a/emulators/emulator-base/src/main/java/cc/squirreljme/emulator/gcf/HostTCPClientConnection.java b/emulators/emulator-base/src/main/java/cc/squirreljme/emulator/gcf/HostTCPClientConnection.java
