+// See license.mkd for licensing and copyright information.
+// ---------------------------------------------------------------------------
+
+package cc.squirreljme.emulator.vm;
+
+import java.util.Locale;
+import java.util.Map;
+
+/**
+ * Validated runtime identity used as the boundary for quirk emulation.
+ *
+ * <p>Profiles other than {@link #IDEAL} are initially identity-only. A
+ * behavior may diverge from the ideal profile only when its compatibility
+ * rule has a focused regression and documented runtime evidence.</p>
+ *
+ * @since 2026/07/21
+ */
+public final class RuntimeProfile
+{
+	/** Property visible to the emulated application. */
+	public static final String PROPERTY =
+		"cc.squirreljme.runtime.profile";
+
+	/** Specification-oriented behavior. */
+	public static final String IDEAL = "ideal";
+
+	/** Nokia's classic KVM family. */
+	public static final String NOKIA_KVM = "nokia-kvm";
+
+	/** Nokia Java Runtime used by later Series 40 devices. */
+	public static final String NOKIA_JRT = "nokia-jrt";
+
+	/** Nokia C2-01 RM-721/RM-722 firmware 11.40 S40 PR9.1. */
+	public static final String NOKIA_S40_PR91_RM72X_V1140 =
+		"nokia-s40-pr9.1-rm72x-v11.40";
+
+	/** Myriad's Jbed runtime. */
+	public static final String MYRIAD_JBED = "myriad-jbed";
+
+	/** Aplix's JBlend runtime. */
+	public static final String APLIX_JBLEND = "aplix-jblend";
+
+	/** IBM's J9 runtime. */
+	public static final String IBM_J9 = "ibm-j9";
+
+	/** Insignia's Jeode runtime. */
+	public static final String INSIGNIA_JEODE = "insignia-jeode";
+
+	/** Sony Ericsson Java Platform runtime family. */
+	public static final String SONY_ERICSSON_JP = "sony-ericsson-jp";
+
+	/** Not used. */
+	private RuntimeProfile()
+	{
+	}
+
+	/**
+	 * Normalizes and validates a profile identifier.
+	 *
+	 * @param __profile The requested identifier, or {@code null} for ideal.
+	 * @return The canonical profile identifier.
+	 * @throws IllegalArgumentException If the identifier is unknown.
+	 * @since 2026/07/21
+	 */
+	public static String normalize(String __profile)
+		throws IllegalArgumentException
+	{
+		if (__profile == null)
+			return RuntimeProfile.IDEAL;
+
+		String profile = __profile.trim().toLowerCase(Locale.ROOT);
+		if (RuntimeProfile.IDEAL.equals(profile) ||
+			RuntimeProfile.NOKIA_KVM.equals(profile) ||
+			RuntimeProfile.NOKIA_JRT.equals(profile) ||
+			RuntimeProfile.NOKIA_S40_PR91_RM72X_V1140.equals(profile) ||
+			RuntimeProfile.MYRIAD_JBED.equals(profile) ||
+			RuntimeProfile.APLIX_JBLEND.equals(profile) ||
+			RuntimeProfile.IBM_J9.equals(profile) ||
+			RuntimeProfile.INSIGNIA_JEODE.equals(profile) ||
+			RuntimeProfile.SONY_ERICSSON_JP.equals(profile))
+			return profile;
+
+		if ("kvm".equals(profile) || "nokia".equals(profile))
+			return RuntimeProfile.NOKIA_KVM;
+		if ("jrt".equals(profile))
+			return RuntimeProfile.NOKIA_JRT;
+		if ("c2-01-v11.40".equals(profile) ||
+			"rm72x-v11.40".equals(profile))
+			return RuntimeProfile.NOKIA_S40_PR91_RM72X_V1140;
+		if ("jbed".equals(profile))
+			return RuntimeProfile.MYRIAD_JBED;
+		if ("jblend".equals(profile))
+			return RuntimeProfile.APLIX_JBLEND;
+		if ("j9".equals(profile))
+			return RuntimeProfile.IBM_J9;
+		if ("jeode".equals(profile) || "jecode".equals(profile))
+			return RuntimeProfile.INSIGNIA_JEODE;
+		if ("sony-ericsson".equals(profile) || "semc".equals(profile))
+			return RuntimeProfile.SONY_ERICSSON_JP;
+
+		throw new IllegalArgumentException(
+			"Unknown runtime profile: " + __profile);
+	}
+
+	/**
+	 * Applies system properties directly confirmed by the selected runtime
+	 * evidence. This must not add inferred limits or behavioral quirks.
+	 *
+	 * @param __profile Normalized runtime profile.
+	 * @param __properties Properties passed to the target VM.
+	 * @throws NullPointerException If either argument is {@code null}.
+	 * @since 2026/08/10
+	 */
+	public static void applyConfirmedProperties(String __profile,
+		Map<String, String> __properties)
+		throws NullPointerException
+	{
+		if (__profile == null || __properties == null)
+			throw new NullPointerException("NARG");
+
+		if (!RuntimeProfile.NOKIA_S40_PR91_RM72X_V1140.equals(__profile))
+			return;
+
+		__properties.put("microedition.configuration", "CLDC-1.1");
+		__properties.put("microedition.profiles", "MIDP-2.1");
+		__properties.put("microedition.encoding", "ISO-8859-1");
+		__properties.put("microedition.jtwi.version", "1.0");
+		__properties.put("microedition.msa.version", "1.0-SUBSET");
+	}
+}
