+++ b/emulators/emulator-base/src/main/java/cc/squirreljme/emulator/gcf/HostTCPClientConnection.java
@@ -0,0 +1,315 @@
+// -*- Mode: Java; indent-tabs-mode: t; tab-width: 4 -*-
+// ---------------------------------------------------------------------------
+// SquirrelJME
+//     Copyright (C) Stephanie Gawroriski <xer@multiphasicapps.net>
+// ---------------------------------------------------------------------------
+// SquirrelJME is under the Mozilla Public License Version 2.0.
+// See license.mkd for licensing and copyright information.
+// ---------------------------------------------------------------------------
+
+package cc.squirreljme.emulator.gcf;
+
+import cc.squirreljme.runtime.gcf.IPAddress;
+import cc.squirreljme.runtime.gcf.TCPClientConnection;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.Socket;
+import javax.microedition.io.SocketConnection;
+
+/**
+ * TCP client connection backed by a host Java socket.
+ *
+ * @since 2026/07/21
+ */
+final class HostTCPClientConnection
+	extends TCPClientConnection
+{
+	/** The host socket. */
+	private final Socket _socket;
+
+	/**
+	 * Initializes the host connection.
+	 *
+	 * @param __addr The connected remote address.
+	 * @param __mode The connection mode.
+	 * @param __socket The connected host socket.
+	 * @throws NullPointerException On null arguments.
+	 * @since 2026/07/21
+	 */
+	HostTCPClientConnection(IPAddress __addr, int __mode, Socket __socket)
+		throws NullPointerException
+	{
+		super(__addr, __mode);
+		if (__socket == null)
+			throw new NullPointerException("NARG");
+		this._socket = __socket;
+	}
+
+	/**
+	 * {@inheritDoc}
+	 * @since 2026/07/21
+	 */
+	@Override
+	protected void doClose()
+		throws IOException
+	{
+		this._socket.close();
+	}
+
+	/**
+	 * {@inheritDoc}
+	 * @since 2026/07/21
+	 */
+	@Override
+	protected String doGetLocalAddress()
+		throws IOException
+	{
+		return this._socket.getLocalAddress().getHostAddress();
+	}
+
+	/**
+	 * {@inheritDoc}
+	 * @since 2026/07/21
+	 */
+	@Override
+	protected int doGetLocalPort()
+		throws IOException
+	{
+		return this._socket.getLocalPort();
+	}
+
+	/**
+	 * {@inheritDoc}
+	 * @since 2026/07/21
+	 */
+	@Override
+	protected int doGetSocketOption(byte __option)
+		throws IllegalArgumentException, IOException
+	{
+		Socket socket = this._socket;
+		switch (__option)
+		{
+			case SocketConnection.DELAY:
+				return socket.getTcpNoDelay() ? 0 : 1;
+			case SocketConnection.LINGER:
+				int linger = socket.getSoLinger();
+				return linger < 0 ? 0 : linger;
+			case SocketConnection.KEEPALIVE:
+				return socket.getKeepAlive() ? 1 : 0;
+			case SocketConnection.RCVBUF:
+				return socket.getReceiveBufferSize();
+			case SocketConnection.SNDBUF:
+				return socket.getSendBufferSize();
+			case SocketConnection.TIMEOUT:
+				return socket.getSoTimeout();
+			default:
+				throw new IllegalArgumentException("EC0n " + __option);
+		}
+	}
+
+	/**
+	 * {@inheritDoc}
+	 * @since 2026/07/21
+	 */
+	@Override
+	protected InputStream doOpenInputStream()
+		throws IOException
+	{
+		return new HostSocketInputStream(this._socket);
+	}
+
+	/**
+	 * {@inheritDoc}
+	 * @since 2026/07/21
+	 */
+	@Override
+	protected OutputStream doOpenOutputStream()
+		throws IOException
+	{
+		return new HostSocketOutputStream(this._socket);
+	}
+
+	/**
+	 * {@inheritDoc}
+	 * @since 2026/07/21
+	 */
+	@Override
+	protected void doSetSocketOption(byte __option, int __value)
+		throws IllegalArgumentException, IOException
+	{
+		Socket socket = this._socket;
+		switch (__option)
+		{
+			case SocketConnection.DELAY:
+				socket.setTcpNoDelay(__value == 0);
+				break;
+			case SocketConnection.LINGER:
+				socket.setSoLinger(__value > 0, __value);
+				break;
+			case SocketConnection.KEEPALIVE:
+				socket.setKeepAlive(__value != 0);
+				break;
+			case SocketConnection.RCVBUF:
+				if (__value > 0)
+					socket.setReceiveBufferSize(__value);
+				break;
+			case SocketConnection.SNDBUF:
+				if (__value > 0)
+					socket.setSendBufferSize(__value);
+				break;
+			case SocketConnection.TIMEOUT:
+				socket.setSoTimeout(__value);
+				break;
+			default:
+				throw new IllegalArgumentException("EC0n " + __option);
+		}
+	}
+
+	/** Host input stream which half-closes the socket. */
+	private static final class HostSocketInputStream
+		extends InputStream
+	{
+		/** The host stream. */
+		private final InputStream _in;
+
+		/** The host socket. */
+		private final Socket _socket;
+
+		/** Is this stream closed? */
+		private boolean _closed;
+
+		HostSocketInputStream(Socket __socket)
+			throws IOException
+		{
+			this._socket = __socket;
+			this._in = __socket.getInputStream();
+		}
+
+		@Override
+		public int available()
+			throws IOException
+		{
+			this.__checkOpen();
+			return this._in.available();
+		}
+
+		@Override
+		public void close()
+			throws IOException
+		{
+			if (this._closed)
+				return;
+			this._closed = true;
+			if (!this._socket.isClosed() &&
+				!this._socket.isInputShutdown())
+				this._socket.shutdownInput();
+		}
+
+		@Override
+		public int read()
+			throws IOException
+		{
+			this.__checkOpen();
+			return this._in.read();
+		}
+
+		@Override
+		public int read(byte[] __data, int __offset, int __length)
+			throws IOException
+		{
+			this.__checkOpen();
+			return this._in.read(__data, __offset, __length);
+		}
+
+		private void __checkOpen()
+			throws IOException
+		{
+			if (this._closed)
+				throw new IOException("EC0r");
+		}
+	}
+
+	/** Host output stream which half-closes the socket. */
+	private static final class HostSocketOutputStream
+		extends OutputStream
+	{
+		/** The host stream. */
+		private final OutputStream _out;
+
+		/** The host socket. */
+		private final Socket _socket;
+
+		/** Is this stream closed? */
+		private boolean _closed;
+
+		HostSocketOutputStream(Socket __socket)
+			throws IOException
+		{
+			this._socket = __socket;
+			this._out = __socket.getOutputStream();
+		}
+
+		@Override
+		public void close()
+			throws IOException
+		{
+			if (this._closed)
+				return;
+			this._closed = true;
+			IOException failure = null;
+			try
+			{
+				this._out.flush();
+			}
+			catch (IOException e)
+			{
+				failure = e;
+			}
+			if (!this._socket.isClosed() &&
+				!this._socket.isOutputShutdown())
+				try
+				{
+					this._socket.shutdownOutput();
+				}
+				catch (IOException e)
+				{
+					if (failure == null)
+						failure = e;
+				}
+			if (failure != null)
+				throw failure;
+		}
+
+		@Override
+		public void flush()
+			throws IOException
+		{
+			this.__checkOpen();
+			this._out.flush();
+		}
+
+		@Override
+		public void write(int __value)
+			throws IOException
+		{
+			this.__checkOpen();
+			this._out.write(__value);
+		}
+
+		@Override
+		public void write(byte[] __data, int __offset, int __length)
+			throws IOException
+		{
+			this.__checkOpen();
+			this._out.write(__data, __offset, __length);
+		}
+
+		private void __checkOpen()
+			throws IOException
+		{
+			if (this._closed)
+				throw new IOException("EC0v");
+		}
+	}
+}
diff --git a/emulators/emulator-base/src/main/java/cc/squirreljme/emulator/vm/RuntimeProfile.java b/emulators/emulator-base/src/main/java/cc/squirreljme/emulator/vm/RuntimeProfile.java
