@@ -41,13 +41,15 @@ public abstract class IPConnectionFactory
 	 * Opens a TCP client connection to the remote address.
 	 *
 	 * @param __addr The address to connect to.
+	 * @param __mode The connection mode.
 	 * @return The connection.
