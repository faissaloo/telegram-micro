+static void sjme_scritchui_gtk2_refreshSoftkeys(
+	sjme_scritchui_uiMenu inMenu, sjme_jint skipIndex)
+{
+	sjme_jint i, n;
+	sjme_scritchui_uiMenuKind parent;
+	sjme_scritchui_uiMenuKind child;
+	sjme_scritchui_uiMenuItem menuItem;
+	GtkWidget* softkeyBar;
+	GtkWidget* left;
+	GtkWidget* right;
+	GtkWidget* options;
+	sjme_jint overflow;
+
+	if (inMenu == NULL)
+		return;
+
+	parent = inMenu->parent.parent;
+	if (parent == NULL ||
+		parent->common.type != SJME_SCRITCHUI_TYPE_MENU_BAR)
+		return;
+
+	softkeyBar = parent->common.handle[SJME_SUI_GTK2_H_TOP_WIDGET];
+	if (softkeyBar == NULL)
+		return;
+
+	/* Rebuild the tiny fixed-capacity footer from semantic key markers. */
+	gtk_container_foreach(GTK_CONTAINER(softkeyBar),
+		sjme_scritchui_gtk2_removeSoftkey, softkeyBar);
+	left = NULL;
+	right = NULL;
+	overflow = 0;
+	n = inMenu->children.numChildren;
+	for (i = 0; i < n; i++)
+	{
+		if (i == skipIndex)
+			continue;
+		child = inMenu->children.children->elements[i];
+		if (child == NULL ||
+			child->common.type != SJME_SCRITCHUI_TYPE_MENU_ITEM)
+		{
+			overflow++;
+			continue;
+		}
+
+		menuItem = (sjme_scritchui_uiMenuItem)child;
+		if (menuItem->accelKey ==
+			SJME_SCRITCHINPUT_KEY_VGAME_COMMAND_LEFT)
+			left = child->common.handle[SJME_SUI_GTK2_H_SOFTKEY];
+		else if (menuItem->accelKey ==
+			SJME_SCRITCHINPUT_KEY_VGAME_COMMAND_RIGHT)
+			right = child->common.handle[SJME_SUI_GTK2_H_SOFTKEY];
+		else
+			overflow++;
+	}
+
+	if (left != NULL)
+		gtk_box_pack_start(GTK_BOX(softkeyBar), left, TRUE, TRUE, 0);
+	if (overflow > 0)
+	{
+		options = inMenu->menuKind.common
+			.handle[SJME_SUI_GTK2_H_SOFTKEY];
+		if (options != NULL)
+			gtk_box_pack_start(GTK_BOX(softkeyBar), options,
+				TRUE, TRUE, 0);
+	}
+	if (right != NULL)
+		gtk_box_pack_start(GTK_BOX(softkeyBar), right, TRUE, TRUE, 0);
+
+	gtk_widget_show_all(softkeyBar);
+}
